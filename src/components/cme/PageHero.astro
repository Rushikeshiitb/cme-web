---
import { href } from '~/lib/nav';
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';

interface Props { eb: string; title: string; lead: string; crumb: string; }
const { eb, title, lead, crumb } = Astro.props;
---
<section class="page-hero"><div class="hero-grid"></div>
  <div class="container">
    <div class="breadcrumb reveal"><a href={href('index')}>Home</a> <Icon name="arrow" stroke={1.6} /> <span>{crumb}</span></div>
    <Eyebrow text={eb} />
    <h1 class="reveal" data-d="1" set:html={title} />
    <p class="lead reveal" data-d="2" set:html={lead} />
  </div>
</section>
