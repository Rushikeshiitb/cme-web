---
import { DEPT } from '~/data/site';
import { href } from '~/lib/nav';
import { asset } from '~/lib/assets';
---
{/* Placeholder logo — replace public/assets/img/logo.png with the real square logo
    and it updates here and on the loading screen (see Preloader.astro). */}
<a class="brand" href={href('index')} aria-label="CME home">
  <img class="mark" src={asset('assets/img/logo.png')} alt="" width="512" height="512" />
  <span>{DEPT.abbr}<small>IIT BOMBAY</small></span>
</a>
