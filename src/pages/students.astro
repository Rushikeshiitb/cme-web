---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/cme/Icon.astro';
import SectionHead from '~/components/cme/SectionHead.astro';
import PageHero from '~/components/cme/PageHero.astro';
import { initials, avatarHue } from '~/lib/text';
import { STUDENTS } from '~/data/site';

const desc = 'Meet the CME student cohort at IIT Bombay and browse their research seminars — from reinforcement learning and quantum physics to music, finance and archaeology.';

const batches = [...new Set(STUDENTS.map((s) => s.batch))].sort();
let idx = 0;
interface Entry { name: string; batch: string; email: string; seminars: { sem: string; term: string; topic: string; guide: string }[]; }
const entries: Entry[] = [];
const groups = batches.map((batch) => {
  const cohort = STUDENTS.filter((s) => s.batch === batch);
  const cards = cohort.map((st) => {
    const cardIdx = idx++;
    entries.push({
      name: st.name,
      batch: st.batch,
      email: st.email ?? '',
      seminars: (st.seminars ?? []).map((sm) => ({
        sem: sm.sem ?? '', term: sm.term ?? '', topic: sm.topic ?? '', guide: sm.guide ?? '',
      })),
    });
    const feat = st.featured;
    const topic = feat && feat.topic ? feat.topic : 'Seminar in progress';
    return { st, cardIdx, topic, n: st.topic_count };
  });
  return { batch, count: cohort.length, cards };
});

// Serialize with the same separators as Python's json.dumps(ensure_ascii=False)
// so the embedded data island matches the original site byte-for-byte.
function pyJson(v: unknown): string {
  if (v === null) return 'null';
  if (typeof v === 'string') return JSON.stringify(v);
  if (typeof v === 'number' || typeof v === 'boolean') return String(v);
  if (Array.isArray(v)) return '[' + v.map(pyJson).join(', ') + ']';
  return '{' + Object.entries(v as Record<string, unknown>).map(([k, val]) => `${JSON.stringify(k)}: ${pyJson(val)}`).join(', ') + '}';
}
const stuData = pyJson(entries).replaceAll('<', '\\u003c');
---
<Base slug="students" title="Students" desc={desc}>
<PageHero
  eb="Students & Seminars"
  title={'Curiosity, <span class="grad-text serif-em">on the record.</span>'}
  lead="Meet the CME cohort and browse the research seminars they've presented — a living map of where multidisciplinary freedom actually leads."
  crumb="Students"
/>

<section class="section" style="background:var(--surface-2)"><div class="container">
  <SectionHead eb="The cohort" title="Every student, every seminar." sub={`All ${STUDENTS.length} CME students, grouped by batch. Click any student to see every research seminar they have worked on.`} />
  {groups.map((g) => (
    <>
      <div class="batch-head"><span>Batch of {g.batch}</span><span>{g.count} student{g.count !== 1 ? 's' : ''}</span></div>
      <div class="stu-grid">{g.cards.map(({ st, cardIdx, topic, n }) => (
        <article class="stu" role="button" tabindex="0" data-stu={cardIdx} aria-label={`View all seminars by ${st.name}`}>
          <div class="stu-head"><div class="avatar" style={`background:var(${avatarHue(st.name)})`}>{initials(st.name)}</div>
            <div><div class="nm">{st.name}</div><div class="batch">BATCH OF {st.batch} · {n} SEMINAR{n !== 1 ? 'S' : ''}</div></div></div>
          <div class="stu-topic"><span class="k">Latest seminar</span>{topic}</div>
          <div class="stu-foot"><span class="stu-more">View all seminars <Icon name="arrow" stroke={1.6} /></span></div>
        </article>
      ))}</div>
    </>
  ))}
</div></section>
<div class="stu-modal" id="stuModal" hidden>
  <div class="stu-modal-backdrop" data-stu-close></div>
  <div class="stu-modal-panel" role="dialog" aria-modal="true" aria-labelledby="stuModalName">
    <button class="stu-modal-close" data-stu-close aria-label="Close"><Icon name="x" /></button>
    <div class="stu-modal-head">
      <div class="avatar" id="stuModalAv"></div>
      <div><div class="nm" id="stuModalName"></div><div class="batch" id="stuModalMeta"></div></div>
    </div>
    <div class="stu-modal-body" id="stuModalBody"></div>
  </div>
</div>
<script id="stu-data" type="application/json" set:html={stuData} is:inline></script>
</Base>
